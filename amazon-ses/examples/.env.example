# Amazon SES SMTP Credentials
# Get these from SES Console → SMTP Settings → Create SMTP Credentials
# https://console.aws.amazon.com/ses/

# SMTP endpoint for your region
# Examples:
#   us-east-1:      email-smtp.us-east-1.amazonaws.com
#   us-west-2:      email-smtp.us-west-2.amazonaws.com
#   eu-west-1:      email-smtp.eu-west-1.amazonaws.com
#   ap-southeast-1: email-smtp.ap-southeast-1.amazonaws.com
SMTP_HOST=email-smtp.us-east-1.amazonaws.com

# Port: 587 (TLS recommended), 465 (SSL), 25, or 2587
SMTP_PORT=587

# SMTP username and password (NOT your AWS access keys)
# Get from SES Console → SMTP Settings → Create SMTP Credentials
SMTP_USER=AKIAXXXXXXXXXXXXXXXX
SMTP_PASS=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender email (must be from a verified domain or email)
FROM_EMAIL=no-reply@yourdomain.com

# Recipient email
# In sandbox mode, this must be a verified email address
# In production mode, any email works
TO_EMAIL=recipient@example.com

# Configuration set to use for tracking
# Must match one of: default-monitoring-config, transactional-config, marketing-config
CONFIGURATION_SET=default-monitoring-config
